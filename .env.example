APP_NAME=JARVIS AI
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/jarvis.db

# Optional OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional Obsidian Local REST API; use exact values shown in plugin settings
OBSIDIAN_BASE_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=
OBSIDIAN_VERIFY_TLS=false

# Remote access stays disabled until authentication and rate limits exist
REMOTE_ACCESS_ENABLED=false
